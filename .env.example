# Copy to .env and fill in locally. Never commit real keys.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
PINECONE_API_KEY=
PINECONE_INDEX_NAME=sports-companion-nebius
# A dense, bring-your-own-vectors index with cosine metric and this dimension.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=4096
CHAT_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
PINECONE_NAMESPACE_PREFIX=sports-companion
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.25
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
# Public sample catalog. Use data/private/matches.json for your prepared reports.
MATCH_CATALOG_PATH=data/matches.json
